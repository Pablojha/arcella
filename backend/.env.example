PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/arcella
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=30d

# Comma-separated list of frontend origins (capacitor://localhost and https://localhost are always allowed)
CLIENT_URL=http://localhost:5173

# Accounts registered with these emails become site admins (comma-separated)
ADMIN_EMAIL=you@example.com

# Optional: Cloudinary for uploads (falls back to local disk when empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: folder for local uploads (default backend/uploads), e.g. a Render persistent disk
UPLOAD_DIR=

# Optional: email for college codes and password resets. Resend is used first, then SMTP.
# In development the code or reset link is printed to the console instead.
MAIL_FROM=Arcella <no-reply@arcella.app>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
